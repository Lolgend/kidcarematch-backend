# ==============================================================================
# Database Configuration
# ==============================================================================
# Database connection string (PostgreSQL / MySQL / SQLite)
DATABASE_URL="mysql://scott:tiger@localhost:3306/kidcarematch_dev"

# Echo SQL queries executed by SQLAlchemy (useful for debugging, true/false)
DB_ECHO="false"

# ==============================================================================
# External API - Data.gov.sg (ECDA Preschool Datasets)
# ==============================================================================
# Base URL for Data.gov.sg datastore search endpoint
DATA_GOV_SG_API_URL="https://data.gov.sg/api/action/datastore_search"

# Data.gov.sg dataset resource ID for Listing of Centres
DATA_GOV_SG_CENTRES_RESOURCE_ID="d_696c994c50745b079b3684f0e90ffc53"

# Data.gov.sg dataset resource ID for Listing of Services
DATA_GOV_SG_SERVICES_RESOURCE_ID="d_44cfe12f2858ae503a093dfc075a28be"

# ==============================================================================
# External API - OneMap (Geocoding & Routing)
# ==============================================================================
# OneMap ElasticSearch API endpoint for geocoding postal codes
ONEMAP_API_URL="https://www.onemap.gov.sg/api/common/elastic/search"

# OneMap routing API endpoint for transit detour routing
ONEMAP_ROUTING_API_URL="https://www.onemap.gov.sg/api/public/routingsvc/route"

# OneMap REST API authentication token (optional)
ONEMAP_API_TOKEN=""

# ==============================================================================
# External AI - Google Gemini (Match Explanation Service)
# ==============================================================================
# Google Gemini API key for generating AI fit explanations (falls back to deterministic explanations if not set)
GEMINI_API_KEY=""

# Gemini model identifier to use for match explanation synthesis
GEMINI_MODEL="gemini-2.5-flash"

# ==============================================================================
# Firebase Authentication & Admin SDK
# ==============================================================================
# Firebase project ID for token verification
FIREBASE_PROJECT_ID="kidcare-match-sg"

# Path to Firebase service account JSON credentials
FIREBASE_CREDENTIALS_PATH="./firebase_svc_acc.json"

# ==============================================================================
# CORS Configuration
# ==============================================================================
# Allowed CORS origins (JSON list)
CORS_ALLOWED_ORIGINS='["http://localhost:3000","https://kidscare-match-sg.web.app","https://kidscare-match-sg.firebaseapp.com"]'
